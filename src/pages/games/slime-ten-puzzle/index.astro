  clock: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  cursor: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3l3 15 2.5-5.5L17 15 6 3z" fill="currentColor"/></svg>`
};

function toggleChip(icon, label) {
