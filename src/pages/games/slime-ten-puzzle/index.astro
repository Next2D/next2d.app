---
/**
 * SlimeTenPuzzle(スライム・テンパズル) 言語振り分けページ
 *
 * 本番はAmplifyの国別リダイレクトが先に効くため、このページはフォールバック用途。
 * navigator.language を見てクライアントサイドで ja / en / cn の各言語版へ振り分ける。
 * JS無効環境向けに meta refresh(1秒後にen版へ)と noscript の3言語リンクを用意する。
 * hreflang の x-default はこのページを指す(各 [lang].astro 側で設定)。
 */

const HUB_URL = 'https://next2d.app/games/slime-ten-puzzle/';
/** リダイレクト先(meta refresh / location.replace)はローカルプレビューやAmplifyのブランチプレビューでも
 *  同一ホスト内で完結するよう相対パスを使う。hreflang/canonical/og:urlはSEO用途のため絶対URL(HUB_URL)のまま。 */
const REL_BASE = '/games/slime-ten-puzzle/';
const OGP_IMAGE = 'https://next2d.app/assets/img/games/slime-ten-puzzle/ogp.png';
const TITLE = 'SlimeTenPuzzle | Next2D Games';
const DESCRIPTION = 'SlimeTenPuzzle(スライム・テンパズル) / Make "10" and feel great! / 凑出「10」,爽快解谜!';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width,initial-scale=1" name="viewport">
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION}>
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#6DD4FF">

  <!-- SEO: Canonical URL(このページ自体がx-defaultの受け皿) -->
  <link rel="canonical" href={HUB_URL}>

  <!-- SEO: hreflang(3言語 + x-default) -->
  <link rel="alternate" hreflang="ja" href={`${HUB_URL}ja/`}>
  <link rel="alternate" hreflang="en" href={`${HUB_URL}en/`}>
  <link rel="alternate" hreflang="zh-CN" href={`${HUB_URL}cn/`}>
  <link rel="alternate" hreflang="x-default" href={HUB_URL}>

  <!-- Facebook / OGP -->
  <meta property="og:title" content={TITLE}>
  <meta property="og:description" content={DESCRIPTION}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={HUB_URL}>
  <meta property="og:image" content={OGP_IMAGE}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Next2D">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={TITLE}>
  <meta name="twitter:description" content={DESCRIPTION}>
  <meta name="twitter:image" content={OGP_IMAGE}>

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon">
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- フォールバック: JS無効環境は1秒後にen版へ -->
  <meta http-equiv="refresh" content={`1;url=${REL_BASE}en/`}>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
      background: #6DD4FF;
      color: #1E3A5F;
    }

    .redirect-box {
      text-align: center;
      padding: 32px;
    }

    .redirect-links {
      margin-top: 16px;
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .redirect-links a {
      color: #1E3A5F;
      font-weight: 700;
      text-decoration: underline;
    }
  </style>

  <script is:inline define:vars={{ relBase: REL_BASE }}>
    (function () {
      var language = (navigator.language || navigator.userLanguage || '').toLowerCase();
      var lang = 'en';
      if (language.indexOf('ja') === 0) {
        lang = 'ja';
      } else if (language.indexOf('zh') === 0) {
        lang = 'cn';
      }
      location.replace(relBase + lang + '/');
    })();
  </script>
</head>
<body>
  <div class="redirect-box">
    <p>SlimeTenPuzzle</p>
    <noscript>
      <div class="redirect-links">
        <a href="/games/slime-ten-puzzle/ja/">日本語</a>
        <a href="/games/slime-ten-puzzle/en/">English</a>
        <a href="/games/slime-ten-puzzle/cn/">简体中文</a>
      </div>
    </noscript>
  </div>
</body>
</html>
