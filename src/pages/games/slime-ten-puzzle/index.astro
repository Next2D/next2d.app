---
/**
 * Slime Ten Puzzle (スライムテンパズル) ランディングページ
 *
 * 公式サイトの共有レイアウト/CSS/JS(main.css, main.js, Bootstrap, AOS)からは
 * 完全に独立した単一ファイル。装飾に使う画像素材はすべてインラインSVGで自作する。
 */

const PAGE_URL = 'https://next2d.app/games/slime-ten-puzzle/';
const OGP_IMAGE = 'https://next2d.app/assets/img/ogp.png'; // TODO: ゲーム専用のOGP画像に差し替え予定
const TITLE = 'スライムテンパズル(Slime Ten Puzzle) | Next2D Games';
const DESCRIPTION = '10をそろえて、サクッと快感。あそんで学べる計算パズルゲーム「スライムテンパズル」。数字を持ったスライムを2体えらんで計算し、最後の1体を10に。理不尽な詰みのない出題と、自分で選べる難易度が特徴。Next2D Framework製。';

/* ------------------------------------------------------------------
 * スライムSVGビルダー
 * ---------------------------------------------------------------- */
const SLIME_COLORS = {
  blue:   { light: '#8FD3FF', base: '#4FA9F0', dark: '#2E7FC4' },
  yellow: { light: '#FFE79A', base: '#FFD34D', dark: '#E0A80F' },
  green:  { light: '#A8F0A0', base: '#6FD96B', dark: '#3FAE3B' },
  purple: { light: '#DCC2F7', base: '#B48BE8', dark: '#8A5CC7' }
};

/** ぷるぷるスライムの本体パス(ドーム型+波打つ下縁)を数式で生成する */
function buildSlimeBodyPath() {
  const left = 24;
  const right = 176;
  const bottomHigh = 150;
  const bottomLow = 170;
  const topY = 26;
  const bumps = 5;
  const width = right - left;
  const step = width / bumps;

  let d = `M${left},108 `;
  d += `C ${left - 14},72 ${left + 8},28 100,${topY} `;
  d += `C ${right - 8},28 ${right + 14},72 ${right},108 `;
  d += `L${right},${bottomHigh} `;
  for (let i = 0; i < bumps; i++) {
    const xStart = right - i * step;
    const xEnd = right - (i + 1) * step;
    const xMid = (xStart + xEnd) / 2;
    d += `Q${xMid},${bottomLow} ${xEnd},${bottomHigh} `;
  }
  d += 'Z';
  return d;
}
const SLIME_BODY_PATH = buildSlimeBodyPath();

/** 独立した <svg> 要素としてスライムを1体描画する */
function slimeSvg({ colorKey = 'blue', number = '', size = 200, animated = false, delay = 0, ariaLabel = null, extraClass = '' }) {
  const c = SLIME_COLORS[colorKey] || SLIME_COLORS.blue;
  const gradId = `sg-${colorKey}-${number}-${Math.round(Math.random() * 1e6)}`;
  const cls = ['slime-svg', animated ? 'slime-anim' : '', extraClass].filter(Boolean).join(' ');
  const style = animated && delay ? ` style="animation-delay:${delay}s"` : '';
  const a11y = ariaLabel ? `role="img" aria-label="${ariaLabel}"` : 'aria-hidden="true"';
  return `
<svg class="${cls}" viewBox="0 0 200 200" width="${size}" height="${size}"${style} ${a11y} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="${c.light}" />
      <stop offset="1" stop-color="${c.base}" />
    </linearGradient>
  </defs>
  <path d="${SLIME_BODY_PATH}" fill="url(#${gradId})" stroke="${c.dark}" stroke-width="3" stroke-linejoin="round" />
  <path d="M108,4 L119,32 L96,32 Z" fill="${c.base}" stroke="${c.dark}" stroke-width="3" stroke-linejoin="round" />
  <ellipse cx="76" cy="84" rx="16" ry="19" fill="#FFFFFF" />
  <ellipse cx="124" cy="84" rx="16" ry="19" fill="#FFFFFF" />
  <circle cx="80" cy="88" r="7" fill="#1E3A5F" />
  <circle cx="128" cy="88" r="7" fill="#1E3A5F" />
  <circle cx="77" cy="84" r="2.4" fill="#FFFFFF" />
  <circle cx="125" cy="84" r="2.4" fill="#FFFFFF" />
  <path d="M82,114 Q100,127 118,114" fill="none" stroke="#1E3A5F" stroke-width="5" stroke-linecap="round" />
  <text x="100" y="144" text-anchor="middle" font-family="'Baloo 2', sans-serif" font-weight="700" font-size="32" fill="#1E3A5F" stroke="#FFFFFF" stroke-width="4" paint-order="stroke" stroke-linejoin="round">${number}</text>
</svg>`;
}

/** 縮小したスライムを <g> として他のSVG内に埋め込む(モック画面などに使用。主SVGと同じ顔パーツを持つ) */
function miniSlimeGroup(x, y, scale, color, number) {
  return `<g transform="translate(${x},${y}) scale(${scale})">
    <g transform="translate(-100,-100)">
      <path d="${SLIME_BODY_PATH}" fill="${color}" stroke="#1E3A5F" stroke-width="4" stroke-linejoin="round" />
      <path d="M108,4 L119,32 L96,32 Z" fill="${color}" stroke="#1E3A5F" stroke-width="4" stroke-linejoin="round" />
      <ellipse cx="76" cy="84" rx="16" ry="19" fill="#FFFFFF" />
      <ellipse cx="124" cy="84" rx="16" ry="19" fill="#FFFFFF" />
      <circle cx="80" cy="88" r="7" fill="#1E3A5F" />
      <circle cx="128" cy="88" r="7" fill="#1E3A5F" />
      <circle cx="77" cy="84" r="2.4" fill="#FFFFFF" />
      <circle cx="125" cy="84" r="2.4" fill="#FFFFFF" />
      <path d="M82,114 Q100,127 118,114" fill="none" stroke="#1E3A5F" stroke-width="5" stroke-linecap="round" />
      <text x="100" y="144" text-anchor="middle" font-family="'Baloo 2', sans-serif" font-weight="700" font-size="32" fill="#1E3A5F" stroke="#FFFFFF" stroke-width="4" paint-order="stroke" stroke-linejoin="round">${number}</text>
    </g>
  </g>`;
}

/** 4方向の先端を持つキラキラ(スパークル)ポリゴンを数式で生成する */
function sparklePolygon(cx, cy, r, color) {
  const spikes = 4;
  const outer = r;
  const inner = r * 0.38;
  const points = [];
  for (let i = 0; i < spikes * 2; i++) {
    const radius = i % 2 === 0 ? outer : inner;
    const angle = (Math.PI / spikes) * i - Math.PI / 2;
    const x = cx + Math.cos(angle) * radius;
    const y = cy + Math.sin(angle) * radius;
    points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return `<polygon points="${points.join(' ')}" fill="${color}" />`;
}

/** クリア演出のキラキラ(スパークル)を複数配置したSVGを生成する */
function sparklesSvg() {
  const marks = [
    sparklePolygon(14, 18, 9, '#FFFFFF'),
    sparklePolygon(106, 14, 7, '#FFFFFF'),
    sparklePolygon(112, 96, 10, '#FFFFFF'),
    sparklePolygon(10, 100, 6, '#FFFFFF')
  ].join('');
  return `<svg class="sparkle-svg" viewBox="0 0 120 120" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">${marks}</svg>`;
}

/** セクション間をつなぐゼリー波形ディバイダー(fillは次のセクション背景色) */
function waveDivider(fill) {
  return `
<svg class="wave-divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <path d="M0,40 C120,78 240,2 360,40 C480,78 600,2 720,40 C840,78 960,2 1080,40 C1200,78 1320,2 1440,40 L1440,80 L0,80 Z" fill="${fill}" />
</svg>`;
}

/** 6つの計算候補ボタン(a+b / a-b / b-a / a×b / a÷b / b÷a)のモックパネル */
function calcPanelSvg() {
  const labels = ['a+b', 'a−b', 'b−a', 'a×b', 'a÷b', 'b÷a'];
  const cols = 3;
  const cellW = 72;
  const cellH = 52;
  const gap = 9;
  const startX = 9;
  const startY = 9;
  const rows = Math.ceil(labels.length / cols);
  const totalW = startX * 2 + cols * cellW + (cols - 1) * gap;
  const totalH = startY * 2 + rows * cellH + (rows - 1) * gap;

  let buttons = '';
  labels.forEach((label, i) => {
    const col = i % cols;
    const row = Math.floor(i / cols);
    const x = startX + col * (cellW + gap);
    const y = startY + row * (cellH + gap);
    const selected = i === 0;
    buttons += `<rect x="${x}" y="${y}" width="${cellW}" height="${cellH}" rx="14" fill="${selected ? '#FFD34D' : '#FFFFFF'}" stroke="#1E3A5F" stroke-width="3" />`;
    buttons += `<text x="${x + cellW / 2}" y="${y + cellH / 2 + 8}" text-anchor="middle" font-family="'Baloo 2', sans-serif" font-weight="700" font-size="22" fill="#1E3A5F">${label}</text>`;
  });

  return `
<svg class="step-illust" viewBox="0 0 ${totalW} ${totalH}" role="img" aria-label="a+b、a-b、b-a、a×b、a÷b、b÷aの6つの計算候補から式を選ぶ操作パネルのイメージ図" xmlns="http://www.w3.org/2000/svg">
  <rect x="0" y="0" width="${totalW}" height="${totalH}" rx="20" fill="#EAF7FF" />
  ${buttons}
</svg>`;
}

/** タップ操作を示すリップル(波紋)アイコン */
function tapIconSvg() {
