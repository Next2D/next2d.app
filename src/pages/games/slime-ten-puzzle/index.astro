      --paper: #FFFFFF;
      --mist: #EAF7FF;
      --slime-blue: #4FA9F0;
      --slime-yellow: #FFD34D;
      --slime-green: #6FD96B;
      --slime-purple: #B48BE8;
      --font-heading: 'Zen Maru Gothic', sans-serif;
      --font-body: 'Zen Maru Gothic', sans-serif;
      --font-accent: 'Baloo 2', sans-serif;
      --shadow-soft: 0 12px 28px rgba(30, 58, 95, 0.12);
      --radius-card: 20px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      font-family: var(--font-body);
      font-weight: 500;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.8;
      overflow-x: hidden;
    }

    img, svg { max-width: 100%; display: block; }

    a { color: inherit; }

    h1, h2, h3 {
      font-family: var(--font-heading);
      font-weight: 900;
      line-height: 1.4;
      margin: 0;
    }

    p { margin: 0; }

    ul { margin: 0; padding: 0; list-style: none; }

    :focus-visible {
      outline: 3px solid var(--ink);
      outline-offset: 3px;
      border-radius: 6px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .container {
      width: 100%;
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.75);
      padding: 6px 16px;
      border-radius: 999px;
      box-shadow: var(--shadow-soft);
    }

    .section-head {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 40px;
    }

    .section-head h2 {
      font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
      color: var(--ink);
    }

    .section-head p {
      margin-top: 12px;
      color: var(--ink);
      opacity: 0.82;
    }

    .section-kicker {
      display: block;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.14em;
      color: var(--sky-deep);
      margin-bottom: 8px;
    }

    /* ---------------- Buttons ---------------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1rem;
      padding: 14px 30px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .btn-primary {
      background: var(--slime-yellow);
      color: var(--ink);
      box-shadow: 0 10px 22px rgba(224, 168, 15, 0.35);
    }

    .btn-primary:hover { transform: translateY(-2px); }

    .btn-outline {
      background: rgba(255, 255, 255, 0.9);
      color: var(--ink);
      border: 2px solid var(--ink);
    }

    .btn-outline:hover { transform: translateY(-2px); }

    .btn[aria-disabled="true"] {
      opacity: 0.62;
      cursor: not-allowed;
      pointer-events: none;
      box-shadow: none;
    }

    .btn-note {
      display: block;
      margin-top: 6px;
      font-size: 0.75rem;
      font-family: var(--font-accent);
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--ink);
      opacity: 0.7;
      text-align: center;
    }

    /* ---------------- Header (minimal) ---------------- */
    .site-mini-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 5;
      padding: 20px 0 0;
    }

    .site-mini-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-accent);
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.85);
      padding: 8px 16px;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.18s ease;
      box-shadow: var(--shadow-soft);
    }

    .brand-mark:hover {
      transform: translateY(-1px);
    }

    /* ---------------- Hero ---------------- */
    .hero {
      position: relative;
      padding: 108px 0 0;
      background: linear-gradient(180deg, var(--sky) 0%, var(--sky-deep) 100%);
      overflow: hidden;
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      text-align: center;
      padding-bottom: 64px;
    }

    .hero h1 {
      margin-top: 18px;
      font-size: clamp(2.2rem, 1.7rem + 2.4vw, 3.4rem);
      color: var(--paper);
      text-shadow: 0 6px 18px rgba(30, 58, 95, 0.25);
    }

    .hero .en-sub {
      display: block;
      margin-top: 6px;
      font-family: var(--font-accent);
      font-weight: 700;
      letter-spacing: 0.08em;
      font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.3rem);
      color: rgba(255, 255, 255, 0.92);
    }

    .hero .catchcopy {
      max-width: 560px;
      margin: 22px auto 0;
      font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
      font-weight: 700;
      color: var(--paper);
    }

    .cloud {
      position: absolute;
      opacity: 0.85;
      z-index: 1;
      animation: cloud-drift 24s ease-in-out infinite;
    }

    .cloud-1 { top: 12%; left: -4%; width: 140px; animation-duration: 26s; }
    .cloud-2 { top: 6%; right: -2%; width: 110px; animation-duration: 22s; animation-delay: -6s; }
    .cloud-3 { top: 42%; left: 4%; width: 90px; opacity: 0.6; animation-duration: 30s; animation-delay: -12s; }

    @keyframes cloud-drift {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(18px); }
    }

    /* ---- Signature visual: 6 + 4 = 10 ---- */
    .equation {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(10px, 2vw, 22px);
      flex-wrap: wrap;
      margin: 44px auto 0;
      max-width: 720px;
    }

    .equation-slime { display: flex; flex-direction: column; align-items: center; }

    .equation-sign {
      font-family: var(--font-accent);
      font-weight: 800;
      font-size: clamp(1.8rem, 1.4rem + 1.6vw, 3rem);
      color: var(--paper);
      text-shadow: 0 4px 10px rgba(30, 58, 95, 0.25);
    }

    .slime-svg { overflow: visible; }

    .slime-anim {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: slime-squish 2.6s ease-in-out infinite;
    }

    @keyframes slime-squish {
      0%, 100% { transform: scaleX(1) scaleY(1); }
      50% { transform: scaleX(1.07) scaleY(0.92); }
    }

    .hero-cta {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: center;
      gap: 20px;
      margin-top: 46px;
    }

    .wave-divider-wrap {
      position: relative;
      z-index: 3;
      line-height: 0;
      margin-top: -2px;
    }

    .wave-divider { width: 100%; height: 44px; display: block; }

    /* ---------------- Generic Section ---------------- */
    section { position: relative; }

    .section-pad { padding: 76px 0; }

    .bg-mist { background: var(--mist); }
    .bg-paper { background: var(--paper); }

    /* ---------------- About / board diagram ---------------- */
    .about-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .about-copy p { margin-bottom: 16px; color: var(--ink); }

    .callout {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: var(--paper);
      border: 2px dashed var(--slime-blue);
      border-radius: 16px;
      padding: 16px 18px;
      font-weight: 700;
      box-shadow: var(--shadow-soft);
    }

    .callout-icon { display: flex; flex: none; width: 26px; height: 26px; color: var(--sky-deep); }
    .callout-icon svg { width: 100%; height: 100%; }

    .board-panel {
      background: linear-gradient(180deg, var(--sky) 0%, var(--sky-deep) 100%);
      border-radius: 24px;
      padding: 28px 20px 20px;
      box-shadow: var(--shadow-soft);
    }

    .board-row {
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    .board-row .slime-svg { width: 100%; height: auto; }

    .board-caption {
      margin-top: 14px;
      text-align: center;
      color: var(--paper);
      font-weight: 700;
      font-size: 0.85rem;
      font-family: var(--font-accent);
      letter-spacing: 0.04em;
    }

    /* ---------------- Steps ---------------- */
    .step-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .step-card {
      position: relative;
      background: var(--paper);
      border-radius: var(--radius-card);
      padding: 30px 22px 26px;
      box-shadow: var(--shadow-soft);
      text-align: center;
    }

    .step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-accent);
      font-weight: 800;
      font-size: 1rem;
      margin-bottom: 14px;
    }

    .step-illust-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 132px;
      margin-bottom: 18px;
    }

    .step-illust { max-height: 100%; }

    .step-pick-row {
      display: flex;
      align-items: flex-end;
      gap: 10px;
    }

    .step-pick-item { position: relative; width: 56px; }

    .step-pick-item .slime-svg { width: 56px; height: 56px; opacity: 0.55; }

    .step-pick-item.is-picked .slime-svg { opacity: 1; }

    .step-pick-item .tap-icon-wrap {
      position: absolute;
      top: -4px;
      left: 50%;
      transform: translateX(-50%);
      width: 38px;
      height: 38px;
      opacity: 0.8;
      pointer-events: none;
    }

    .step-result-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .step-result-wrap .slime-svg { width: 96px; height: 96px; }

    .sparkle-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

    .step-card h3 {
      font-size: 1.05rem;
      margin-bottom: 8px;
    }

    .step-card p { color: var(--ink); opacity: 0.78; font-size: 0.92rem; }

    /* ---------------- Feature cards ---------------- */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .feature-card {
      background: var(--paper);
      border-radius: var(--radius-card);
      padding: 26px 20px;
      box-shadow: var(--shadow-soft);
    }

    .feature-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: var(--mist);
      color: var(--sky-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }

    .feature-icon svg { width: 24px; height: 24px; }

    .feature-card h3 { font-size: 1rem; margin-bottom: 8px; }

    .feature-card p { font-size: 0.88rem; color: var(--ink); opacity: 0.78; }

    .toggle-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }

    .toggle-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--mist);
      border: 1.5px solid rgba(30, 58, 95, 0.14);
      border-radius: 999px;
      padding: 5px 10px 5px 8px;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .toggle-chip-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--paper);
      font-family: var(--font-accent);
      font-size: 0.7rem;
      color: var(--sky-deep);
    }

    .toggle-chip-state {
      font-family: var(--font-accent);
      color: var(--ink);
      opacity: 0.5;
      letter-spacing: 0.04em;
    }

    .feature-icon-pair { display: flex; gap: 6px; }
    .feature-icon-pair svg { width: 22px; height: 22px; }

    /* ---------------- Modes ---------------- */
    .mode-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .mode-card {
      background: var(--paper);
      border-radius: var(--radius-card);
      padding: 28px 22px;
      box-shadow: var(--shadow-soft);
      border-top: 6px solid var(--slime-blue);
    }

    .mode-card.mode-timeattack { border-top-color: var(--slime-yellow); }
    .mode-card.mode-tutorial { border-top-color: var(--slime-green); }

    .mode-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 84px;
      height: 84px;
      color: var(--sky-deep);
      margin-bottom: 14px;
    }

    .mode-icon svg { width: 100%; height: 100%; }

    .mode-card h3 { font-size: 1.05rem; margin-bottom: 10px; }
    .mode-card p { font-size: 0.9rem; color: var(--ink); opacity: 0.8; margin-bottom: 14px; }

    .time-chip-row { display: flex; gap: 8px; flex-wrap: wrap; }

    .time-chip {
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 0.78rem;
      background: var(--mist);
      color: var(--ink);
      padding: 6px 12px;
      border-radius: 999px;
    }

    /* ---------------- Screenshots ---------------- */
    .shot-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .shot-card {
      background: var(--paper);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
    }

    .shot-card svg { width: 100%; aspect-ratio: 16 / 9; display: block; }

    .shot-caption {
      padding: 14px 16px;
      font-weight: 700;
      font-size: 0.9rem;
      text-align: center;
    }

    .shot-note {
      text-align: center;
      margin-top: 20px;
      font-size: 0.78rem;
      color: var(--ink);
      opacity: 0.6;
    }

    /* ---------------- Trial / store ---------------- */
    .trial-panel {
      background: linear-gradient(180deg, var(--sky) 0%, var(--sky-deep) 100%);
      border-radius: 28px;
      padding: 48px 32px;
      text-align: center;
      color: var(--paper);
      box-shadow: var(--shadow-soft);
    }

    .trial-panel h2 { color: var(--paper); }

    .trial-panel p {
      max-width: 520px;
      margin: 14px auto 0;
      opacity: 0.95;
      font-weight: 700;
    }

    .trial-cta { margin-top: 30px; }

    .store-chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
      margin-top: 34px;
    }

    .store-chip {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.92);
      color: var(--ink);
      border-radius: 16px;
      padding: 10px 16px;
      box-shadow: var(--shadow-soft);
    }

    .store-chip-icon { width: 26px; height: 26px; color: var(--ink); }
    .store-chip-icon svg { width: 100%; height: 100%; }

    .store-chip-text { text-align: left; line-height: 1.3; }
    .store-chip-text strong { display: block; font-size: 0.86rem; }
    .store-chip-text small { display: block; font-size: 0.68rem; opacity: 0.65; font-family: var(--font-accent); letter-spacing: 0.04em; }

    /* ---------------- Spec table ---------------- */
    .spec-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--paper);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
    }

    .spec-table tr:not(:last-child) th,
    .spec-table tr:not(:last-child) td {
      border-bottom: 1px solid rgba(30, 58, 95, 0.1);
    }

    .spec-table th, .spec-table td {
      text-align: left;
      padding: 16px 20px;
      font-size: 0.92rem;
      vertical-align: top;
    }

    .spec-table th {
      width: 34%;
      font-family: var(--font-heading);
      font-weight: 700;
      color: var(--sky-deep);
      background: var(--mist);
    }

    /* ---------------- Footer ---------------- */
    .site-footer {
      background: var(--ink);
      color: rgba(255, 255, 255, 0.88);
      padding: 40px 0;
      text-align: center;
    }

    .site-footer a {
      color: var(--paper);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .site-footer .copyright {
      margin-top: 10px;
      font-size: 0.78rem;
      opacity: 0.7;
      font-family: var(--font-accent);
    }

    /* ---------------- Responsive ---------------- */
    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; }
      .feature-grid { grid-template-columns: repeat(2, 1fr); }
      .step-grid { grid-template-columns: 1fr; }
      .mode-grid { grid-template-columns: 1fr; }
      .shot-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 560px) {
      .feature-grid { grid-template-columns: 1fr; }
      .section-pad { padding: 56px 0; }
      .equation { gap: 8px; }
      .equation-slime svg { width: 78px; height: 78px; }
      .equation-slime.is-result svg { width: 108px; height: 108px; }
      .hero { padding-top: 92px; }
      .trial-panel { padding: 36px 20px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .slime-anim, .cloud {
        animation: none !important;
      }
    }
  </style>
</head>
<body>

  <header class="site-mini-header">
    <div class="container">
      <a class="brand-mark" href="https://next2d.app/ja/"><span aria-hidden="true">&larr;</span> Next2D</a>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="cloud cloud-1" set:html={cloudSvg()} />
    <div class="cloud cloud-2" set:html={cloudSvg()} />
    <div class="cloud cloud-3" set:html={cloudSvg()} />

    <div class="container hero-inner">
      <span class="eyebrow">Next2D Games</span>
      <h1>スライムテンパズル<span class="en-sub">Slime Ten Puzzle</span></h1>
      <p class="catchcopy">10をそろえて、サクッと快感。あそんで学べるパズルゲーム。</p>

      <div class="equation" aria-hidden="false">
        <div class="equation-slime" set:html={heroSlimeA} />
        <span class="equation-sign" aria-hidden="true">+</span>
        <div class="equation-slime" set:html={heroSlimeB} />
        <span class="equation-sign" aria-hidden="true">=</span>
        <div class="equation-slime is-result" set:html={heroSlimeResult} />
      </div>

      <div class="hero-cta">
        <div>
          <button class="btn btn-primary" type="button" aria-disabled="true" disabled>体験版であそぶ</button>
          <span class="btn-note">Coming Soon</span>
        </div>
        <div>
          <a class="btn btn-outline" href="#spec">対応プラットフォームを見る</a>
        </div>
      </div>
    </div>

    <div class="wave-divider-wrap" set:html={waveDivider('#FFFFFF')} />
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="bg-paper section-pad" id="about">
    <div class="container about-grid">
      <div class="about-copy">
        <span class="section-kicker">ABOUT THE GAME</span>
        <h2>どんなゲーム?</h2>
        <p>
          画面には数字を持ったスライムが4体並んでいます。スライムを2体タップすると、
          「a+b」「a−b」「a×b」など6つの計算候補が現れるので、好きな式を選びましょう。
          選んだ2体は式の答えを持つ1体に合体します。
        </p>
        <p>
          これを繰り返して、最後に残った1体が「10」ならクリア。10以外の数字で終わるとゲームオーバーです。
        </p>
        <div class="callout">
          <span class="callout-icon" set:html={ICONS.shieldCheck} />
          <span>出題は必ず10が作れる組み合わせだけを検証して生成しています。理不尽な詰みはありません。</span>
        </div>
      </div>

      <div class="board-panel">
        <div class="board-row">
          {boardSlimes.map((s) => (
            <div class="board-slime" set:html={slimeSvg({ colorKey: s.colorKey, number: s.number, size: 130, ariaLabel: `数字${s.number}を持つスライム` })} />
          ))}
        </div>
        <p class="board-caption">この4体から、10が作れる組み合わせを見つけよう</p>
      </div>
    </div>
  </section>

  <!-- ============ HOW TO PLAY ============ -->
  <section class="bg-mist section-pad" id="how-to-play">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">3 STEPS</span>
        <h2>あそびかた</h2>
        <p>操作はとってもシンプル。スライムを選んで、式を選ぶだけです。</p>
      </div>

      <div class="step-grid">
        <div class="step-card">
          <span class="step-number">1</span>
          <div class="step-illust-wrap">
            <div class="step-pick-row">
              {stepPickSlimes.map((s) => (
                <div class={`step-pick-item ${s.picked ? 'is-picked' : ''}`}>
                  {s.picked && <div class="tap-icon-wrap" set:html={tapIconSvg()} />}
                  <div set:html={slimeSvg({ colorKey: s.colorKey, number: s.number, size: 100, ariaLabel: `数字${s.number}を持つスライム` })} />
                </div>
              ))}
            </div>
          </div>
          <h3>スライムを2体えらぶ</h3>
          <p>計算したい2体をタップ(コントローラーでも選択可)。</p>
        </div>

        <div class="step-card">
          <span class="step-number">2</span>
          <div class="step-illust-wrap" set:html={calcPanelSvg()} />
          <h3>けいさんをえらぶ</h3>
          <p>a+b / a−b / b−a / a×b / a÷b / b÷a から式をえらぶ。</p>
        </div>

        <div class="step-card">
          <span class="step-number">3</span>
          <div class="step-illust-wrap">
            <div class="step-result-wrap">
              <div set:html={slimeSvg({ colorKey: 'yellow', number: '10', size: 110, ariaLabel: '数字10を持つ黄色いスライム' })} />
              <div class="sparkle-wrap" set:html={sparklesSvg()} />
            </div>
          </div>
          <h3>くりかえして、さいごの1体を10に!</h3>
          <p>最後の1体が10ならクリア。10以外だとゲームオーバー。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="bg-paper section-pad" id="features">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">FEATURES</span>
        <h2>とくちょう</h2>
      </div>

      <div class="feature-grid">
        <div class="feature-card">
          <span class="feature-icon" set:html={ICONS.shieldCheck} />
          <h3>理不尽ゼロの出題</h3>
          <p>すべての問題は「必ず10が作れる」ことを検証してから出題。運ゲーではありません。</p>
        </div>

        <div class="feature-card">
          <h3>難しさは自分でえらべる</h3>
          <p>掛け算・割り算・マイナスの数・分数をON/OFFで調整。初期状態は全OFFなので、小さな子どもから遊べます。</p>
          <div class="toggle-chips">
            <div set:html={toggleChip('×', '掛け算')} />
            <div set:html={toggleChip('÷', '割り算')} />
            <div set:html={toggleChip('−', 'マイナスの数')} />
            <div set:html={toggleChip('½', '分数')} />
          </div>
        </div>

        <div class="feature-card">
          <span class="feature-icon" set:html={ICONS.star} />
          <h3>難しい設定ほど高スコア</h3>
          <p>マイナスの数+5点、分数+10点、掛け算ON+5点など、難易度に応じたボーナス点で高得点を狙えます。</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon feature-icon-pair">
            <span set:html={ICONS.phone} />
            <span set:html={ICONS.pad} />
          </div>
          <h3>タップでもコントローラーでも</h3>
          <p>スマホのタップ操作はもちろん、ゲームパッド(コントローラー)にも完全対応。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MODES ============ -->
  <section class="bg-mist section-pad" id="modes">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">GAME MODES</span>
        <h2>ゲームモード</h2>
      </div>

      <div class="mode-grid">
        <div class="mode-card mode-normal">
          <span class="mode-icon" set:html={ICONS.infinity} />
          <h3>ノーマル</h3>
          <p>時間無制限。クリアするたびに次の問題が出るエンドレスモード。</p>
        </div>

        <div class="mode-card mode-timeattack">
          <span class="mode-icon" set:html={ICONS.clock} />
          <h3>タイムアタック</h3>
          <p>1分・5分・10分から時間を選択。モードごとにハイスコアを記録できます。</p>
          <div class="time-chip-row">
            <span class="time-chip">1分</span>
            <span class="time-chip">5分</span>
            <span class="time-chip">10分</span>
          </div>
        </div>

        <div class="mode-card mode-tutorial">
          <span class="mode-icon" set:html={ICONS.cursor} />
          <h3>チュートリアル</h3>
          <p>手のカーソルが次に押すスライムとおすすめの計算をナビゲートしてくれます。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SCREENSHOTS ============ -->
  <section class="bg-paper section-pad" id="screenshots">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">SCREENSHOTS</span>
        <h2>スクリーンショット</h2>
      </div>

      <div class="shot-grid">
        <div class="shot-card">
          <div set:html={screenshotHome()} />
          <p class="shot-caption">ホーム画面</p>
        </div>
        <div class="shot-card">
          <div set:html={screenshotPlay()} />
          <p class="shot-caption">プレイ画面</p>
        </div>
        <div class="shot-card">
          <div set:html={screenshotModal()} />
          <p class="shot-caption">計算選択モーダル</p>
        </div>
      </div>
      <p class="shot-note">※開発中の画面イメージです。実際の製品版とは異なる場合があります。</p>
    </div>
  </section>

  <!-- ============ TRIAL / STORE ============ -->
  <section class="bg-mist section-pad" id="trial">
    <div class="container">
      <div class="trial-panel">
        <h2>体験版・ストア</h2>
        <p>体験版では「タイムアタック」と「チュートリアル」があそべます(ノーマルモードは製品版のみ)。</p>

        <div class="trial-cta">
          <button class="btn btn-primary" type="button" aria-disabled="true" disabled>Web体験版であそぶ</button>
          <span class="btn-note">Coming Soon</span>
        </div>

        <div class="store-chip-row">
          <div set:html={storeChip(ICONS.phone, 'App Store')} />
          <div set:html={storeChip(ICONS.phone, 'Google Play')} />
          <div set:html={storeChip(ICONS.monitor, 'Steam')} />
          <div set:html={storeChip(ICONS.pad, 'Xbox')} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPEC ============ -->
  <section class="bg-paper section-pad" id="spec">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">SPEC</span>
        <h2>スペック</h2>
      </div>

      <table class="spec-table">
        <tbody>
          <tr>
            <th scope="row">対応プラットフォーム</th>
            <td>Web / iOS / Android / Windows / macOS / Linux(Steam)/ Xbox ※すべて準備中・近日公開</td>
          </tr>
          <tr>
            <th scope="row">画面・フレームレート</th>
            <td>1280 × 720 ・ 60fps</td>
          </tr>
          <tr>
            <th scope="row">操作方法</th>
            <td>タップ操作 / ゲームパッド(コントローラー)操作に対応</td>
          </tr>
          <tr>
            <th scope="row">料金</th>
            <td>未定</td>
          </tr>
          <tr>
            <th scope="row">開発</th>
            <td>Next2D</td>
          </tr>
          <tr>
            <th scope="row">エンジン</th>
            <td>Next2D Framework v4</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

