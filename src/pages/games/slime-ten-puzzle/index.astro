  ${panel}
</svg>`;
}

/** 計算候補パネルをモーダルモック用に座標指定して描く(位置調整版) */
function calcPanelSvgInline() {
  const labels = ['a+b', 'a−b', 'b−a', 'a×b', 'a÷b', 'b÷a'];
  const cols = 3;
  const cellW = 62;
  const cellH = 34;
  const gap = 8;
  const originX = 62;
  const originY = 56;
  let out = '';
  labels.forEach((label, i) => {
    const col = i % cols;
    const row = Math.floor(i / cols);
    const x = originX + col * (cellW + gap);
    const y = originY + row * (cellH + gap);
    const selected = i === 0;
    out += `<rect x="${x}" y="${y}" width="${cellW}" height="${cellH}" rx="10" fill="${selected ? '#FFD34D' : '#EAF7FF'}" stroke="#1E3A5F" stroke-width="2" />`;
    out += `<text x="${x + cellW / 2}" y="${y + cellH / 2 + 5}" text-anchor="middle" font-family="'Baloo 2', sans-serif" font-weight="700" font-size="14" fill="#1E3A5F">${label}</text>`;
  });
  return out;
}

