  publisher: { '@type': 'Organization', name: 'Next2D', url: 'https://next2d.app/' }
};

/** セクション間をつなぐゼリー波形ディバイダー(fillは次のセクション背景色) */
function waveDivider(fill) {
  return `
<svg class="wave-divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <path d="M0,40 C120,78 240,2 360,40 C480,78 600,2 720,40 C840,78 960,2 1080,40 C1200,78 1320,2 1440,40 L1440,80 L0,80 Z" fill="${fill}" />
</svg>`;
}
