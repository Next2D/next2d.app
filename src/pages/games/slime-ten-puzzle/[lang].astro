  <!-- SEO: Canonical URL -->
  <link rel="canonical" href={canonical}>

  <!-- SEO: hreflang(3言語 + x-default) -->
  <link rel="alternate" hreflang="ja" href={CANONICAL.ja}>
  <link rel="alternate" hreflang="en" href={CANONICAL.en}>
  <link rel="alternate" hreflang="zh-CN" href={CANONICAL.cn}>
  <link rel="alternate" hreflang="x-default" href={HUB_URL}>

  <!-- SEO: 構造化データ(VideoGame) -->
  <script type="application/ld+json" set:html={JSON.stringify(GAME_JSONLD)} />

  <!-- Facebook / OGP -->
  <meta property="og:title" content={t.title}>
  <meta property="og:description" content={t.description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={OGP_IMAGE}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Next2D">
  <meta property="og:locale" content={OG_LOCALE[lang]}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={t.title}>
  <meta name="twitter:description" content={t.description}>
  <meta name="twitter:image" content={OGP_IMAGE}>

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon">
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- LCP: ヒーローのロゴ/背景を先読み -->
  <link rel="preload" as="image" href="/assets/img/games/slime-ten-puzzle/logo.svg" fetchpriority="high">
  <link rel="preload" as="image" href="/assets/img/games/slime-ten-puzzle/hero-loop.webp">

  <style is:global>
    :root {
      --sky: #6DD4FF;
      --sky-deep: #3FA8E8;
      --ink: #1E3A5F;
      --paper: #FFFFFF;
      --mist: #EAF7FF;
      --slime-blue: #4FA9F0;
      --slime-yellow: #FFD34D;
      --slime-green: #6FD96B;
      --slime-purple: #B48BE8;
      --font-heading: "Hiragino Maru Gothic ProN", "Hiragino Kaku Gothic ProN", "BIZ UDPGothic", "Yu Gothic", "Meiryo", system-ui, sans-serif;
      --font-body: "Hiragino Maru Gothic ProN", "Hiragino Kaku Gothic ProN", "BIZ UDPGothic", "Yu Gothic", "Meiryo", system-ui, sans-serif;
      --font-accent: ui-rounded, "Hiragino Maru Gothic ProN", "Arial Rounded MT Bold", system-ui, sans-serif;
      --shadow-soft: 0 12px 28px rgba(30, 58, 95, 0.12);
      --radius-card: 20px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      font-family: var(--font-body);
      font-weight: 500;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.8;
      overflow-x: hidden;
    }

    img, svg { max-width: 100%; display: block; }

    a { color: inherit; }

    h1, h2, h3 {
      font-family: var(--font-heading);
      font-weight: 700;
      line-height: 1.4;
      margin: 0;
    }

    p { margin: 0; }

    ul { margin: 0; padding: 0; list-style: none; }

    :focus-visible {
      outline: 3px solid var(--ink);
      outline-offset: 3px;
      border-radius: 6px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .container {
      width: 100%;
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .section-head {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 40px;
    }

    .section-head h2 {
      font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
      color: var(--ink);
    }

    .section-head p {
      margin-top: 12px;
      color: var(--ink);
      opacity: 0.82;
    }

    /* ---------------- Hero ---------------- */
    .hero {
      position: relative;
      padding: 92px 0 0;
      background: var(--sky); /* 画像読み込み前のちらつき防止フォールバック */
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: url('/assets/img/games/slime-ten-puzzle/hero-loop.webp') repeat-x 0 0 / 1024px 100%;
      animation: hero-pan 48s linear infinite;
    }

    @keyframes hero-pan {
      to { background-position-x: -1024px; }
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      text-align: center;
      padding-bottom: 28px;
    }

    .hero h1 {
      margin-top: 2px;
    }

    .hero h1 img {
      display: block;
      width: clamp(330px, 30vw + 180px, 620px);
      height: auto;
      margin: 0 auto;
      filter: drop-shadow(0 6px 18px rgba(30, 58, 95, 0.3));
    }

    .hero .catchcopy {
      max-width: 560px;
      margin: 10px auto 0;
      font-size: clamp(1.1rem, 1.045rem + 0.33vw, 1.32rem);
      font-weight: 700;
      color: var(--paper);
      text-shadow: 0 2px 6px rgba(30, 58, 95, 0.55), 0 4px 14px rgba(30, 58, 95, 0.4);
    }

    .hero .catchcopy .catchcopy-line {
      display: block;
    }

    .hero .catchcopy .catchcopy-line + .catchcopy-line {
      margin-top: 4px;
    }

    /* ---- Signature visual: 6 + 4 = 10 ---- */
    .equation {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: clamp(10px, 2vw, 22px);
      flex-wrap: wrap;
      margin: 20px auto 0;
      max-width: 720px;
    }

    .equation-slime { display: flex; flex-direction: column; align-items: center; }

    .equation-sign {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 108px;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: clamp(1.8rem, 1.4rem + 1.6vw, 3rem);
      color: var(--paper);
      text-shadow: 0 2px 6px rgba(30, 58, 95, 0.55), 0 4px 12px rgba(30, 58, 95, 0.4);
    }

    .slime-svg { overflow: visible; }

    .slime-anim {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: slime-squish 2.6s ease-in-out infinite;
    }

    @keyframes slime-squish {
      0%, 100% { transform: scaleX(1) scaleY(1); }
      50% { transform: scaleX(1.07) scaleY(0.92); }
    }

    .equation-slime img {
      display: block;
      width: 108px;
      height: auto;
      transform-origin: bottom center;
      animation: slime-squish 2.6s ease-in-out infinite;
    }

    .hero-store-badges {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 14px;
      margin-top: 22px;
    }

    .store-badge-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 147px;
      height: 54px;
      border-radius: 10px;
      transition: transform 0.18s ease;
    }

    .store-badge-link:hover {
      transform: translateY(-2px);
    }

    .store-badge-link.is-app-store img {
      display: block;
      height: 54px;
      width: auto;
    }

    .store-badge-link.is-steam {
      background: #211F1F;
    }

    .store-badge-link.is-steam img {
      display: block;
      height: 33px;
      width: auto;
    }

    .wave-divider-wrap {
      position: relative;
      z-index: 3;
      line-height: 0;
      margin-top: -2px;
      margin-bottom: -1px;
    }

    .wave-divider { width: 100%; height: 44px; display: block; }

    /* ---------------- Generic Section ---------------- */
    section { position: relative; }

    .section-pad { padding: 60px 0 76px; }

    .bg-mist { background: var(--mist); }
    .bg-paper { background: var(--paper); }

    /* ---------------- Steps ---------------- */
    .step-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .step-card {
      display: flex;
      flex-direction: column;
      background: var(--paper);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
    }

    .step-screenshot { position: relative; line-height: 0; }

    .step-screenshot img {
      display: block;
      width: 100%;
      height: auto;
    }

    .step-number {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 1rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .step-body {
      padding: 22px 22px 26px;
      text-align: center;
    }

    .step-card h3 {
      font-size: 1.05rem;
      margin-bottom: 8px;
    }

    .step-card p { color: var(--ink); opacity: 0.78; font-size: 0.92rem; }

    /* ---------------- Feature cards ---------------- */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      background: var(--paper);
      border-radius: var(--radius-card);
      padding: 28px 22px 32px;
      box-shadow: var(--shadow-soft);
    }

    .feature-card h3 { font-size: 1rem; margin-bottom: 8px; }

    .feature-card p { font-size: 0.88rem; color: var(--ink); opacity: 0.78; }

    /* ---------------- Modes ---------------- */
    .mode-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .mode-card {
      display: flex;
      flex-direction: column;
      background: var(--paper);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-soft);
      border-top: 6px solid var(--slime-blue);
    }

    .mode-card.mode-normal { border-top-color: #9934ED; }
    .mode-card.mode-timeattack { border-top-color: #0AA192; }
    .mode-card.mode-tutorial { border-top-color: var(--slime-green); }

    .mode-screenshot { line-height: 0; }

    .mode-screenshot img {
      display: block;
      width: 100%;
      height: auto;
    }

    .mode-body {
      padding: 22px 22px 28px;
    }

    .mode-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 50px;
      color: var(--sky-deep);
      margin-bottom: 14px;
    }

    .mode-icon img { display: block; width: 150px; height: auto; max-width: none; }

    .mode-card h3 { font-size: 1.05rem; margin-bottom: 10px; }
    .mode-card p { font-size: 0.9rem; color: var(--ink); opacity: 0.8; margin-bottom: 14px; }

    /* ---------------- Spec meta ---------------- */
    /* ---------------- System requirements (Steam) ---------------- */
    .sysreq-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .sysreq-card {
      background: var(--paper);
      border-radius: var(--radius-card);
      padding: 22px 18px;
      box-shadow: var(--shadow-soft);
    }

    .sysreq-os {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      margin-bottom: 4px;
    }

    .sysreq-block {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid rgba(30, 58, 95, 0.1);
    }

    .sysreq-block:first-of-type {
      margin-top: 14px;
      padding-top: 0;
      border-top: none;
    }

    .sysreq-block-min {
      min-height: 422px;
    }

    .sysreq-block-label {
      display: inline-block;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      color: var(--paper);
      background: #1372B0;
      padding: 3px 12px;
      border-radius: 999px;
    }

    .sysreq-list {
      margin: 10px 0 0;
    }

    .sysreq-list dt {
      font-size: 0.72rem;
      font-weight: 700;
      color: #1372B0;
      letter-spacing: 0.02em;
      margin-top: 8px;
    }

    .sysreq-list dt:first-child { margin-top: 0; }

    .sysreq-list dd {
      margin: 2px 0 0;
      font-size: 0.86rem;
      color: var(--ink);
      opacity: 0.9;
    }

    /* ---------------- Footer ---------------- */
    .site-footer {
      background: var(--ink);
      color: rgba(255, 255, 255, 0.88);
      padding: 40px 0;
      text-align: center;
    }

    .site-footer a {
      color: var(--paper);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .site-footer .copyright {
      margin-top: 10px;
      font-size: 0.78rem;
      opacity: 0.7;
      font-family: var(--font-accent);
    }

    /* ---------------- Responsive ---------------- */
    @media (max-width: 900px) {
      .feature-grid { grid-template-columns: 1fr; }
      .step-grid { grid-template-columns: 1fr; }
      .mode-grid { grid-template-columns: 1fr; }
      .sysreq-grid { grid-template-columns: 1fr; }
      .sysreq-block-min { min-height: 0; }
    }

    @media (max-width: 560px) {
      .section-pad { padding: 44px 0 56px; }
      .equation { gap: 8px; }
      .equation-slime img { width: 78px; }
      .equation-sign { height: 78px; }
      .hero { padding-top: 104px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .slime-anim, .equation-slime img, .hero::before {
        animation: none !important;
      }
    }
  </style>
</head>
<body>

  <main>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <h1><img src="/assets/img/games/slime-ten-puzzle/logo.svg" alt={t.logoAlt} width="658" height="354" fetchpriority="high"></h1>
      <p class="catchcopy">
        <span class="catchcopy-line">{t.catchLine1}</span>
        <span class="catchcopy-line">{t.catchLine2}</span>
      </p>

      <div class="equation" aria-hidden="false">
        <div class="equation-slime">
          <img src="/assets/img/games/slime-ten-puzzle/blue_slime.svg" width="120" height="120" alt={t.slime4Alt} style="animation-delay:0s">
        </div>
        <span class="equation-sign" aria-hidden="true">+</span>
        <div class="equation-slime">
          <img src="/assets/img/games/slime-ten-puzzle/green_slime.svg" width="120" height="120" alt={t.slime6Alt} style="animation-delay:0.15s">
        </div>
        <span class="equation-sign" aria-hidden="true">=</span>
        <div class="equation-slime is-result">
          <img src="/assets/img/games/slime-ten-puzzle/yellow_slime.svg" width="120" height="144.44" alt={t.slime10Alt} style="animation-delay:0.3s">
        </div>
      </div>

      <div class="hero-store-badges">
        {/* ストアは未申請のため、公開まではリンク先が404になります */}
        <a class="store-badge-link is-app-store" href={APP_STORE[lang].href} target="_blank" rel="noopener">
          <img src={APP_STORE[lang].img} width={APP_STORE[lang].width} height="40" alt={t.appStoreAlt}>
        </a>
        {/* ストアは未申請のため、公開まではリンク先が404になります */}
        <a class="store-badge-link is-steam" href={STEAM_URL} target="_blank" rel="noopener">
          <img src="/assets/img/games/slime-ten-puzzle/steam-lockup.png" width="1120" height="400" alt={t.steamAlt}>
        </a>
      </div>
    </div>

    <div class="wave-divider-wrap" set:html={waveDivider('#FFFFFF')} />
  </section>

  <!-- ============ HOW TO PLAY ============ -->
  <section class="bg-paper section-pad" id="how-to-play">
    <div class="container">
      <div class="section-head">
        <h2>{t.howToPlay.heading}</h2>
        <p>{t.howToPlay.sub}</p>
      </div>

      <div class="step-grid">
        <div class="step-card">
          <div class="step-screenshot">
            <span class="step-number">1</span>
            <img src="/assets/img/games/slime-ten-puzzle/step1.webp" srcset="/assets/img/games/slime-ten-puzzle/step1_640.webp 640w, /assets/img/games/slime-ten-puzzle/step1.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.howToPlay.steps[0].imgAlt} loading="lazy">
          </div>
          <div class="step-body">
            <h3>{t.howToPlay.steps[0].title}</h3>
            <p set:html={t.howToPlay.steps[0].body} />
          </div>
        </div>

        <div class="step-card">
          <div class="step-screenshot">
            <span class="step-number">2</span>
            <img src="/assets/img/games/slime-ten-puzzle/step2.webp" srcset="/assets/img/games/slime-ten-puzzle/step2_640.webp 640w, /assets/img/games/slime-ten-puzzle/step2.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.howToPlay.steps[1].imgAlt} loading="lazy">
          </div>
          <div class="step-body">
            <h3>{t.howToPlay.steps[1].title}</h3>
            <p set:html={t.howToPlay.steps[1].body} />
          </div>
        </div>

        <div class="step-card">
          <div class="step-screenshot">
            <span class="step-number">3</span>
            <img src="/assets/img/games/slime-ten-puzzle/step3.webp" srcset="/assets/img/games/slime-ten-puzzle/step3_640.webp 640w, /assets/img/games/slime-ten-puzzle/step3.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.howToPlay.steps[2].imgAlt} loading="lazy">
          </div>
          <div class="step-body">
            <h3>{t.howToPlay.steps[2].title}</h3>
            <p set:html={t.howToPlay.steps[2].body} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ POINTS ============ -->
  <section class="bg-mist section-pad" id="features">
    <div class="container">
      <div class="section-head">
        <h2>{t.features.heading}</h2>
      </div>

      <div class="feature-grid">
        {t.features.cards.map((card) => (
          <div class="feature-card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MODES ============ -->
  <section class="bg-paper section-pad" id="modes">
    <div class="container">
      <div class="section-head">
        <h2>{t.modes.heading}</h2>
      </div>

      <div class="mode-grid">
        <div class="mode-card mode-normal">
          <div class="mode-screenshot">
            <img src="/assets/img/games/slime-ten-puzzle/normal_mode.webp" srcset="/assets/img/games/slime-ten-puzzle/normal_mode_640.webp 640w, /assets/img/games/slime-ten-puzzle/normal_mode.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.modes.normal.imgAlt} loading="lazy">
          </div>
          <div class="mode-body">
            <span class="mode-icon">
              <img src="/assets/img/games/slime-ten-puzzle/normal_play_btn.svg" width="224" height="60" alt={t.modes.normal.iconAlt}>
            </span>
            <h3>{t.modes.normal.title}</h3>
            <p>{t.modes.normal.body}</p>
          </div>
        </div>

        <div class="mode-card mode-timeattack">
          <div class="mode-screenshot">
            <img src="/assets/img/games/slime-ten-puzzle/time_attack_mode.webp" srcset="/assets/img/games/slime-ten-puzzle/time_attack_mode_640.webp 640w, /assets/img/games/slime-ten-puzzle/time_attack_mode.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.modes.timeattack.imgAlt} loading="lazy">
          </div>
          <div class="mode-body">
            <span class="mode-icon">
              <img src="/assets/img/games/slime-ten-puzzle/time_attack_btn.svg" width="224" height="60" alt={t.modes.timeattack.iconAlt}>
            </span>
            <h3>{t.modes.timeattack.title}</h3>
            <p>{t.modes.timeattack.body}</p>
          </div>
        </div>

        <div class="mode-card mode-tutorial">
          <div class="mode-screenshot">
            <img src="/assets/img/games/slime-ten-puzzle/tutorial_mode.webp" srcset="/assets/img/games/slime-ten-puzzle/tutorial_mode_640.webp 640w, /assets/img/games/slime-ten-puzzle/tutorial_mode.webp 1280w" sizes="(max-width: 900px) 90vw, 300px" width="1280" height="720" alt={t.modes.tutorial.imgAlt} loading="lazy">
          </div>
          <div class="mode-body">
            <h3>{t.modes.tutorial.title}</h3>
            <p>{t.modes.tutorial.body}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPEC ============ -->
  <section class="bg-mist section-pad" id="spec">
    <div class="container">
      <div class="section-head">
        <h2>{t.spec.heading}</h2>
      </div>

      <div class="sysreq-grid">
        {t.spec.requirements.map((req) => (
          <div class="sysreq-card">
            <p class="sysreq-os">{req.os}</p>

            <div class="sysreq-block sysreq-block-min">
              <span class="sysreq-block-label">{t.spec.min}</span>
              <dl class="sysreq-list">
                {req.min.map((item) => (
                  <>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </>
                ))}
              </dl>
            </div>

            <div class="sysreq-block">
              <span class="sysreq-block-label">{t.spec.rec}</span>
              <dl class="sysreq-list">
                {req.rec.map((item) => (
                  <>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </>
                ))}
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  </main>

  <!-- ============ FOOTER ============ -->
